 "vo": [
  {
   "id": "m0a",
   "start": 0.5,
   "dur": 5.919388,
   "sub": "That's OpenCrabs answering on a Mac. Here's how you get there, with one Homebrew command."
  },
  {
   "id": "m0b",
   "start": 6.9693879999999995,
   "dur": 5.799546,
   "sub": "Open Terminal. Press Command and Space, type Terminal, and press Enter."
  },
  {
   "id": "m1a",
   "start": 14.718934,
   "dur": 10.144376,
   "sub": "Type brew install opencrabs, and press Enter. Homebrew downloads the ready-made build for Apple Silicon, plus two small helpers."
  },
  {
   "id": "m1b",
   "start": 25.41331,
   "dur": 10.998481,
   "sub": "If Terminal says \"command not found: brew\", you don't have Homebrew yet. Install it from brew.sh (the command is in the description), then run this line again."
  },
  {
   "id": "m2a",
   "start": 38.361791,
   "dur": 9.276304,
   "sub": "Now type opencrabs and press Enter. The setup wizard opens. It's the same wizard as in the Linux video, so here's the fast version."
  },
  {
   "id": "m2b",
   "start": 48.18809499999999,
   "dur": 6.680136,
   "sub": "QuickStart. Keep the .opencrabs folder with Seed template files ticked: that's your crab's personality."
  },
  {
   "id": "m2c",
   "start": 55.418230999999984,
   "dur": 9.741542,
   "sub": "For Brain Fuel we use z.ai with GLM. On a coding plan, pick Coding API, then paste your key. It stays hidden."
  },
  {
   "id": "m2d",
   "start": 65.70977299999998,
   "dur": 7.709932,
   "sub": "Keep the default model. Skip Always On and Make It Yours for now. Every check passes, and you're in."
  },
  {
   "id": "m2e",
   "start": 73.96970499999998,
   "dur": 6.582925,
   "sub": "Say hi. It answers. Yours will be different, but OpenCrabs is installed and running."
  },
  {
   "id": "m2f",
   "start": 81.10262999999998,
   "dur": 10.746848,
   "sub": "If macOS keeps asking whether Terminal can access data from other apps, give Terminal Full Disk Access once, in System Settings, Privacy and Security."
  },
  {
   "id": "m3a",
   "start": 93.79947799999998,
   "dur": 9.175646,
   "sub": "From now on, just type opencrabs in any terminal. To update, type /evolve inside OpenCrabs. It handles the rest."
  },
  {
   "id": "m3b",
   "start": 103.52512399999998,
   "dur": 6.095646,
   "sub": "Next up: connect Telegram, and chat with your crab from your phone. See you there."
  }
 ],
